{
  "manifest_version": 3,
  "name": "Odoo Reset Hub",
  "version": "2.0.0",
  "description": "One-click Odoo password reset (v16-v19). Detects the database from the current tab and logs you in.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "activeTab", "scripting", "cookies", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
